# /etc/agentvc-cloud.env on the VM (chmod 600). Never commit the real one.
AGENTVC_CLOUD_PUBLIC_URL=https://agentvc.example.com
AGENTVC_CLOUD_ALLOW_USERS=ykirpichev
# GitHub OAuth app (Settings > Developer settings > OAuth Apps); callback URL
# is <public url>/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token.
TUNNEL_TOKEN=
