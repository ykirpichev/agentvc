{
  "name": "agentvc",
  "displayName": "agentvc",
  "description": "Review agent work in the editor with the same branch graph as the web UI: drag to rebase, resolve conflicts inline, see every window's stack.",
  "version": "0.2.1",
  "publisher": "avc",
  "license": "MIT OR Apache-2.0",
  "preview": true,
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/ykirpichev/agentvc"
  },
  "homepage": "https://github.com/ykirpichev/agentvc/tree/main/integrations/vscode",
  "bugs": {
    "url": "https://github.com/ykirpichev/agentvc/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "workspaceContains:.agentvc",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentvc",
          "title": "agentvc",
          "icon": "media/agentvc.svg"
        }
      ]
    },
    "views": {
      "agentvc": [
        {
          "type": "webview",
          "id": "agentvc.branches",
          "name": "Branches",
          "icon": "media/agentvc.svg",
          "contextualTitle": "agentvc"
        }
      ]
    },
    "commands": [
      {
        "command": "agentvc.refresh",
        "title": "Refresh",
        "category": "agentvc",
        "icon": "$(refresh)"
      },
      {
        "command": "agentvc.install",
        "title": "Install agentvc on This Machine",
        "category": "agentvc",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentvc.setup",
        "title": "Set Up agentvc in This Folder",
        "category": "agentvc",
        "icon": "$(rocket)"
      },
      {
        "command": "agentvc.startDaemon",
        "title": "Start agentvcd",
        "category": "agentvc",
        "icon": "$(play)"
      },
      {
        "command": "agentvc.compareAttempts",
        "title": "Compare Two Attempts…",
        "category": "agentvc",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "agentvc.compareWithParent",
        "title": "Show Changes",
        "category": "agentvc",
        "icon": "$(diff)"
      },
      {
        "command": "agentvc.openFileDiff",
        "title": "Open Changed File…",
        "category": "agentvc",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentvc.openView",
        "title": "Open View in New Window",
        "category": "agentvc",
        "icon": "$(empty-window)"
      },
      {
        "command": "agentvc.addViewToWorkspace",
        "title": "Add View to Workspace",
        "category": "agentvc",
        "icon": "$(root-folder)"
      },
      {
        "command": "agentvc.fork",
        "title": "Fork Attempt",
        "category": "agentvc",
        "icon": "$(repo-forked)"
      },
      {
        "command": "agentvc.markPassed",
        "title": "Mark Passed",
        "category": "agentvc",
        "icon": "$(pass)"
      },
      {
        "command": "agentvc.markFailed",
        "title": "Mark Failed",
        "category": "agentvc",
        "icon": "$(error)"
      },
      {
        "command": "agentvc.markExploring",
        "title": "Mark Exploring",
        "category": "agentvc"
      },
      {
        "command": "agentvc.promote",
        "title": "Promote (Pick Winner)",
        "category": "agentvc",
        "icon": "$(star-full)"
      },
      {
        "command": "agentvc.abandon",
        "title": "Abandon…",
        "category": "agentvc",
        "icon": "$(circle-slash)"
      },
      {
        "command": "agentvc.stopRun",
        "title": "Stop Run",
        "category": "agentvc",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentvc.openPr",
        "title": "Open Pull Request",
        "category": "agentvc",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "agentvc.openInWebUi",
        "title": "Open in Review UI",
        "category": "agentvc",
        "icon": "$(link-external)"
      },
      {
        "command": "agentvc.revealCurrent",
        "title": "Show Current Attempt",
        "category": "agentvc"
      },
      {
        "command": "agentvc.stack.refresh",
        "title": "Refresh Stack",
        "category": "agentvc stack",
        "icon": "$(refresh)"
      },
      {
        "command": "agentvc.stack.create",
        "title": "New Stacked Branch…",
        "category": "agentvc stack",
        "icon": "$(add)"
      },
      {
        "command": "agentvc.stack.modify",
        "title": "Amend Current Branch (Restack Above)",
        "category": "agentvc stack",
        "icon": "$(edit)"
      },
      {
        "command": "agentvc.stack.commit",
        "title": "Add Commit to Current Branch…",
        "category": "agentvc stack",
        "icon": "$(git-commit)"
      },
      {
        "command": "agentvc.stack.restack",
        "title": "Restack",
        "category": "agentvc stack",
        "icon": "$(layers)"
      },
      {
        "command": "agentvc.stack.sync",
        "title": "Sync with Trunk",
        "category": "agentvc stack",
        "icon": "$(sync)"
      },
      {
        "command": "agentvc.stack.submit",
        "title": "Submit Stack (Push and PRs)",
        "category": "agentvc stack",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentvc.stack.up",
        "title": "Up the Stack",
        "category": "agentvc stack",
        "icon": "$(arrow-up)"
      },
      {
        "command": "agentvc.stack.down",
        "title": "Down the Stack",
        "category": "agentvc stack",
        "icon": "$(arrow-down)"
      },
      {
        "command": "agentvc.stack.top",
        "title": "Top of the Stack",
        "category": "agentvc stack"
      },
      {
        "command": "agentvc.stack.bottom",
        "title": "Bottom of the Stack",
        "category": "agentvc stack"
      },
      {
        "command": "agentvc.stack.adopt",
        "title": "Track Existing Branch…",
        "category": "agentvc stack",
        "icon": "$(git-branch)"
      },
      {
        "command": "agentvc.stack.focus",
        "title": "Show Stack",
        "category": "agentvc stack"
      },
      {
        "command": "agentvc.stack.squash",
        "title": "Squash Current Branch",
        "category": "agentvc stack"
      },
      {
        "command": "agentvc.openReview",
        "title": "Open Review",
        "category": "agentvc",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentvc.openReview",
          "when": "view == agentvc.branches",
          "group": "navigation@1"
        },
        {
          "command": "agentvc.openInWebUi",
          "when": "view == agentvc.branches",
          "group": "navigation@2"
        },
        {
          "command": "agentvc.startDaemon",
          "when": "view == agentvc.branches && agentvc.state != connected",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "agentvc.compareAttempts",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.compareWithParent",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.openFileDiff",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.openView",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.addViewToWorkspace",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.fork",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.markPassed",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.markFailed",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.markExploring",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.promote",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.abandon",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.stopRun",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.openPr",
          "when": "config.agentvc.attemptCommands"
        },
        {
          "command": "agentvc.revealCurrent",
          "when": "config.agentvc.attemptCommands"
        }
      ]
    },
    "configuration": {
      "title": "agentvc",
      "properties": {
        "agentvc.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7420",
          "description": "URL of a running agentvcd. When nothing answers there, the extension can start its own (see agentvc.autoStartDaemon)."
        },
        "agentvc.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Start agentvcd for this workspace on a free port when agentvc.daemonUrl does not answer."
        },
        "agentvc.cliPath": {
          "type": "string",
          "default": "agentvc",
          "description": "Path to the agentvc CLI, used for set up, fork, pull requests, and as a read-only fallback when no daemon is reachable. A bare name is looked up on PATH, then in ~/.local/bin (where the installer puts it), ~/.cargo/bin, /usr/local/bin and /opt/homebrew/bin. In a remote window this is a path on the remote host."
        },
        "agentvc.daemonPath": {
          "type": "string",
          "default": "agentvcd",
          "description": "Path to the agentvcd binary used by Start agentvcd. A bare name is looked up like agentvc.cliPath, then next to the CLI."
        },
        "agentvc.attemptCommands": {
          "type": "boolean",
          "default": false,
          "description": "Show the attempt history commands (fork, compare attempts, mark, promote, abandon, open PR from an attempt) in the command palette. Off by default: day to day you work with workspaces, stacks and agents."
        },
        "agentvc.forkActor": {
          "type": "string",
          "default": "human",
          "description": "Actor recorded on attempts forked from the editor."
        },
        "agentvc.confirmPromote": {
          "type": "boolean",
          "default": true,
          "description": "Ask before promoting, since promoting abandons the task's other open attempts."
        },
        "agentvc.stack.showOtherWindows": {
          "type": "boolean",
          "default": true,
          "description": "List the other worktrees' stacks (read-only) under the Stack view."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p test --noEmit",
    "compile-tests": "tsc -p test",
    "test:unit": "npm run compile-tests && mocha 'out/integrations/vscode/test/unit/**/*.test.js'",
    "test": "npm run build && npm run compile-tests && node out/integrations/vscode/test/runTest.js",
    "package": "npm run build && vsce package --no-dependencies -o agentvc.vsix",
    "publish:vsce": "vsce publish --no-dependencies --packagePath agentvc.vsix",
    "publish:ovsx": "ovsx publish agentvc.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.90.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0",
    "mocha": "^11.1.0",
    "ovsx": "^1.4.0",
    "typescript": "^5.7.3",
    "ws": "^8.18.0"
  },
  "keywords": [
    "agents",
    "ai",
    "version control",
    "review",
    "diff",
    "attempts",
    "claude",
    "cursor"
  ],
  "galleryBanner": {
    "color": "#1e1b3a",
    "theme": "dark"
  }
}
